autostart = "@PLUGIN_ES1BENCHMARK_AUTOSTART@"

# Cold-startup benchmark monitor configuration.
# Set notifyhost to the IP of the machine running es1_benchmark_coldstart.py.
# Set thunderhost to the IP of this ES1 device (so the Python server knows where to connect back).
configuration = {
    "notifyhost":  "127.0.0.1",
    "notifyport":  8080,
    "thunderhost": "127.0.0.1",
    "thunderport": 55555
}
